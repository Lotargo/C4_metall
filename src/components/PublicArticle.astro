---
import { getEntry, render } from 'astro:content';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ThemeHead from './ThemeHead.astro';
import ThemeToggle from './ThemeToggle.astro';
import { sitePath } from '../utils/site-path.mjs';
import '../styles/global.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/metall.css';
import '../styles/interactive.css';
import '../styles/overview.css';
import '../styles/models.css';
const { id, page, title, subtitle } = Astro.props;
const entry = await getEntry('publicArticles', id);
if (!entry) throw new Error('Missing public article');
const { Content, headings } = await render(entry);
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{entry.data.title} — Подготовка производства</title><meta name="description" content={entry.data.summary}/><meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#f4f6f8"/><link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')}/><ThemeHead/></head>
<body><a class="skip-link" href="#main">Перейти к статье</a><ThemeToggle/><div class="metall-page" id="page-start"><SiteHeader page={page} title={title} subtitle={subtitle}/><main id="main"><section class="section model-intro" id="top"><div class="wrap"><p class="eyebrow">Материалы / {title}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p></div></section><div class="wrap model-article-layout"><aside class="model-article-toc"><nav aria-label="Содержание статьи"><p class="eyebrow">В этой статье</p>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></aside><article class="model-article"><Content/></article></div></main><SiteFooter/></div></body></html>
