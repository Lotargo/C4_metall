---
import Icon from './Icon.astro';
import icons from '../data/metall-icons.json';
const { roles } = Astro.props;
const llmCount = roles.filter((role) => role.kind === 'llm').length;
---
<div class="roster-heading" id="roles"><span class="roster-symbol"><Icon name="machines" /></span><div><p class="eyebrow">Роли в процессе</p><h3 class="roster-title">Кто есть кто</h3></div><span class="roster-hint">Задача, вход и результат каждой роли</span></div>
<div class="agents-controls"><div class="filter-chips" aria-label="Фильтр ролей"><button data-agent-filter="all" aria-pressed="true">Все роли</button><button data-agent-filter="llm" aria-pressed="false"><Icon name="scenarios" /> ИИ-агенты · {llmCount}</button><button data-agent-filter="code" aria-pressed="false"><Icon name="machines" /> Программа · {roles.length - llmCount}</button></div><div class="agent-search"><Icon name="search" /><input type="search" data-agent-search-input aria-label="Найти роль или задачу" placeholder="Найти роль или задачу…" /><button type="button" data-agent-search-clear aria-label="Очистить поиск ролей" hidden><Icon name="close" /></button></div><span class="agent-count" id="agent-count" role="status" aria-live="polite">{roles.length} ролей</span></div>
<div class="agents-table role-cards">{roles.map((r, i) => <details class="agent-row role-card" data-agent-kind={r.kind} data-agent-search={r.title + ' ' + r.name + ' ' + r.stage}><summary><span class="role-symbol"><Icon name={r.icon as keyof typeof icons} /><span class="agent-number">{String(i + 1).padStart(2, '0')}</span></span><span class="agent-summary"><span class="agent-title">{r.title}</span><span class="agent-name">{r.name} · {r.stage}</span><span class="role-meta"><span class:list={['badge', { agent: r.kind === 'llm' }]}>{r.kind === 'llm' ? 'ИИ-агент' : 'Программа'}</span><span class="role-open-label">Подробнее</span></span></span><span class="role-chevron" aria-hidden="true"><Icon name="chevron" /></span></summary><div class="agent-body"><dl class="role-facts"><div><dt>Когда работает</dt><dd>{r.when}</dd></div><div><dt>Что получает</dt><dd>{r.input}</dd></div><div><dt>Что возвращает</dt><dd>{r.output}</dd></div><div><dt>Граница результата</dt><dd>{r.limits}</dd></div></dl></div></details>)}</div>
<div class="agent-empty" data-agent-empty hidden><Icon name="search" /><p>Подходящих ролей нет. Попробуйте другое название или выберите все роли.</p></div>
