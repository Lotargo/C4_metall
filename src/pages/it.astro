---
import data from '../data/evidence.json';
import SourceLinks from '../components/SourceLinks.astro';
import TechnicalAtlas from '../components/TechnicalAtlas.astro';
import Flow from '../components/Flow.astro';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '../styles/global.css';
import '../styles/flow.css';
const { audit, steps, agents, storageGroups, sources } = data;
const date = new Date(audit.capturedAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const plural = (n, one, few, many) => n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? few : many;
const labels = { trace: 'История обработки', cycle: 'Цикл D001', passport: 'Паспорт', nsi: 'НСИ', materials: 'Материалы', machines: 'Оборудование', route: 'Прежний маршрут' };
const tableCount = storageGroups.reduce((sum, g) => sum + g.tables.length, 0);
// Lifecycle of one cycle: execution states and result statuses from domain/d001_cycles.py.
const lifecycle = {
  lanes: [
    { id: 'code', label: 'Исполнение' },
    { id: 'human', label: 'Решение технолога' },
    { id: 'source', label: 'Остановка' },
  ],
  nodes: [
    { id: 'queued', col: 0, lane: 'code', kind: 'code', shape: 'start', title: 'queued' },
    { id: 'running', col: 1, lane: 'code', kind: 'code', title: 'running · стадия' },
    { id: 'enough', col: 2, lane: 'code', kind: 'code', shape: 'decision', title: 'Можно продолжать?' },
    { id: 'completed', col: 3, lane: 'code', kind: 'result', shape: 'end', title: 'completed · sufficient / partial' },
    { id: 'waiting', col: 1, lane: 'human', kind: 'human', title: 'waiting_decision · needs_*_review' },
    { id: 'stopped', col: 2, lane: 'source', kind: 'source', title: 'cancelled · failed · interrupted' },
  ],
  edges: [
    { from: 'queued', to: 'running' },
    { from: 'running', to: 'enough' },
    { from: 'enough', to: 'completed', label: 'да' },
    { from: 'enough', to: 'waiting', label: 'нет', via: 'bottom' },
    { from: 'waiting', to: 'running', label: 'явный resume', dashed: true },
    { from: 'running', to: 'stopped', dashed: true },
  ],
};
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Подготовка производства — технический разбор</title>
  <meta name="description" content="Технический разбор: C4-архитектура, путь от загрузки до сметы, цикл D001, роли и инструкции, SQL-схемы и фрагменты исходников."/>
  <meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#f7f6f2"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
</head>
<body class="technical-page">
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">ПП</span><span>Подготовка<br/>производства</span></a><nav aria-label="Технические разделы"><a href="#architecture">C4</a><a href="#implementation">Исполнение</a><a href="#cycle">Цикл</a><a href="#agents">Роли</a><a href="#data">Данные</a></nav><a class="audience-link" href="/">К презентации <span aria-hidden="true">↗</span></a></div></header>
  <main id="main">
    <section class="section"><div class="wrap"><p class="eyebrow">Для IT-специалистов</p><h1 class="technical-title">Реализация,<br/>данные и основания.</h1><p class="lead technical-lead">Схемы C4, путь исполнения от загрузки до сметы, контракты ролей, SQL-схемы и ссылки на точные фрагменты кода.</p><div class="audit-strip"><div><span>Снимок исходников</span><b>{date}</b></div><div><span>Ветка и коммит</span><b><code>{audit.branch} · {audit.head.slice(0,7)}</code></b></div><div><span>Доказательства</span><b>{audit.sourceCount} {plural(audit.sourceCount,'фрагмент','фрагмента','фрагментов')} · {audit.referencedFiles} {plural(audit.referencedFiles,'файл','файла','файлов')} · {tableCount} SQL-таблиц</b></div></div><p class="chapter-footnote">{audit.workingTree.startsWith('captured paths clean') ? 'Захваченные каталоги mvp/src/metall_mvp, mvp/instructions, mvp/skills, web/src и docs/agents совпадают с коммитом, незакоммиченных правок в них нет.' : 'Снимок включает незакоммиченные изменения.'} Описание подтверждает реализацию в коде; оно не является новым запуском модели, чтением рабочих баз или инженерной приёмкой.</p></div></section>

    <section class="section wash"><div class="wrap"><p class="eyebrow">01 / Структура</p><h2>Архитектура C4</h2><details class="bounded-detail architecture-explorer" id="architecture" open><summary>Контекст, контейнеры, компоненты и код <span aria-hidden="true">+</span></summary><p>Выберите уровень, фокус и блок. Справа — назначение блока, вход, выход и ссылки на код. Схему можно масштабировать, перемещать, открыть на весь экран и скачать в SVG.</p><TechnicalAtlas/></details></div></section>

    <section class="section" id="implementation"><div class="wrap"><p class="eyebrow">02 / Исполнение</p><h2>Путь от загрузки до сметы</h2><div class="it-stages">{steps.map((s,i)=><details class="bounded-detail"><summary><span class="it-stage-heading"><span class="ordinal">{String(i+1).padStart(2,'0')}</span>{s.name}<span class="it-tag">{s.tag}</span></span><span aria-hidden="true">+</span></summary><h3>{s.title}</h3><p>{s.text}</p><ul class="fact-list">{s.facts.map(f=><li>{f}</li>)}</ul><p>Результат: <code>{s.output}</code></p><SourceLinks ids={s.sources}/></details>)}</div>
      <details class="bounded-detail reading-method"><summary>Чтение чертежа: инструкция, навыки, контракт и уточнение <span aria-hidden="true">+</span></summary><ol><li><b>Изображения.</b> PDFium рендерит один лист PDF с целевыми 300 DPI; Pillow нормализует растр. Обзор — до 2048 px, полный рендер — до 8192 px и 64 млн пикселей. Текстовый слой PDF — подсказка.</li><li><b>Инструкция.</b> Режим чтения выбирает набор навыков. UI запрашивает <code>autonomous</code>: базовая инструкция + навыки <code>geometry-rotational</code>, <code>geometry-sheet-metal</code>, <code>geometry-weldment</code> + <code>SOURCE_READING_SCOPE_PROMPT</code>. Режим <code>skills</code> подключает <code>engineering-drawing-vision</code> со справочными разделами. Состав, версии и хеши навыков пишутся в trace.</li><li><b>Модель.</b> Для <code>codex_cli</code>, <code>opencode_cli</code> и <code>antigravity_cli</code> полный рендер копируется в рабочий каталог; модель может увеличивать области, измерять по пикселям запрещено. OCR-движок не вызывается.</li><li><b>Семантика.</b> Надпись читается буквально, затем устанавливается владелец по выносным линиям; вид, разрез и выносной элемент — изображения, а не физические элементы; неустановленная принадлежность остаётся в <code>unmapped_facts</code>.</li><li><b>Уточнение v1.</b> Агент 2 получает кроп, проверочный обзор, индекс известных фактов и <code>AgentTwoPatch</code>; по умолчанию — один первичный вызов, до двух fallback-вызовов и двух кропов. <code>reading_v2</code> эту ветку не проходит.</li><li><b>Детерминированная проекция.</b> Код нормализует ссылки, объединяет расхождения, строит упоминания, собирает <code>DrawingPassport v2</code>, проверяет покрытие и ссылки, строит таблицу и review bundle.</li></ol><p><b>Граница точности.</b> В <code>autonomous</code> часть размерных аннотаций получает общую область <code>[0.05, 0.05, 0.95, 0.95]</code>, которая не доказывает точную локализацию. Инструкция не гарантирует качество ответа.</p><SourceLinks ids={['raster','skillActivation','skillCompose','skillRegistry','readingScope','readingMethod','nativePixels','cliWorkspace','featureSchema','readingSchema','pipeline','budget','cropCall','v1Adapter','autonomousEvidence','builder','review']}/></details>
      <details class="bounded-detail"><summary>Поверхности, упоминания и ручные ревизии паспорта <span aria-hidden="true">+</span></summary><ol><li><b>Модель элемента.</b> <code>Feature.is_internal</code> учитывает только <code>geometry_role = surface</code>; явная <code>physical_side</code> важнее вида элемента.</li><li><b>Упоминания.</b> Каждое «Ø/⌀ число» в описании становится <code>GeometryMention</code>; роль переносится от элемента только при уникальной цитате длиной от 12 символов, иначе <code>unresolved</code>.</li><li><b>Таблица.</b> «Наружный диаметр» — при стороне external или наблюдаемом вращательном сечении без явной стороны; «Внутренний» — internal; при разных сторонах — «принадлежность не подтверждена»; роль <code>position</code> — размер расположения.</li><li><b>Расчёт.</b> <code>physical_geometry</code> исключает размеры stock/position-элементов; паспорт-источник не меняется.</li><li><b>Ручная ревизия.</b> <code>SurfaceRegistry</code> меняет сторону, роль, вид, размеры и требования; основание обязательно. «Сверено с оригиналом» → <code>observed / operator_confirmed</code>, иначе <code>uncertain / operator_corrected</code>.</li></ol><SourceLinks ids={['featureSurface','mentionModel','geometryMentions','mentionChecks','diameterLabels','physicalGeometry','surfaceRegistry','operator','reviewCurrent']}/></details>
    </div></section>

    <section class="section wash" id="cycle"><div class="wrap"><p class="eyebrow">03 / Цикл D001</p><h2>Цикл до сметы</h2><p class="technical-lead">Новые загрузки по умолчанию закрепляют цикл D001 до распознавания. После общих входов координатор ведёт стадии: карта → операции → время → экономика → смета. Состояние исполнения и полнота результата хранятся раздельно.</p>
      <Flow id="cycle-lifecycle" label="Состояния цикла D001" {...lifecycle} legend={false} />
      <p class="flow-note">Состояния исполнения: <code>queued</code>, <code>running</code>, <code>waiting_decision</code>, <code>completed</code>, <code>failed</code>, <code>cancelled</code>, <code>interrupted</code>. Полнота результата: <code>absent</code>, <code>partial</code>, <code>sufficient</code>, <code>needs_scope_review</code>, <code>needs_route_review</code>. Продолжение после ожидания или прерывания — только явной командой.</p>
      <div class="cycle-grid">
        <article><h3>Закрепление и бюджет</h3><ul class="fact-list"><li>До фонового распознавания в событие <code>automatic_cycle.pinned</code> записываются ID цикла, <code>RolePin</code> пяти ролей (provider, model, effort, версия и SHA-256 инструкции, контракт) и лимиты.</li><li>Лимиты по умолчанию: 8 вызовов, 600 000 токенов, 3600 с. Проверяются перед каждым следующим вызовом; уже идущий вызов может превысить предел.</li><li>Изменённая конфигурация сервера при загрузке — 409 до создания запуска; изменённый файл инструкции — отказ <code>instruction_changed</code> до вызова.</li></ul><SourceLinks ids={['autoScope','upload','rolePin','rolePins','coordinatorBudget']}/></article>
        <article><h3>Исполнитель ролей и публикация</h3><ul class="fact-list"><li>Ручной и автоматический путь используют один <code>DraftService</code>: пакет, захват слота, вызов, валидация контракта, публикация.</li><li>Каждое число ответа — <code>DraftValue</code> с basis и <code>source_refs</code>; ссылки сверяются с переданным пакетом, новые расчёты требуют исполненного <code>calculation_ref</code>.</li><li>Служебные ID в текстах для оператора — причина отказа. Отказ сохраняется, но не публикуется; явный повтор получает прежний ответ и замечания при совпадении основания.</li></ul><SourceLinks ids={['draftClaim','publish','sourceRefs','operationAssemble']}/></article>
        <article><h3>Время и смета</h3><ul class="fact-list"><li>Роль времени возвращает операнды: <code>direct</code> (min), <code>length_feed</code> (mm, mm/min), <code>volume_rate</code> (mm3, mm3/min). Минуты считает <code>Decimal</code>: T_партии = ΣT_наладки + N × ΣT_шт.</li><li>Смета: материал = расход × цена × N, операция = минуты / 60 × ставка; закупка — по явной политике. Без обязательного входа — <code>partial</code>, полный итог <code>null</code>.</li><li>Экран и CSV/XLSX/JSON читают одну ревизию; ручные правки создают новые ревизии без модели.</li></ul><SourceLinks ids={['timeMethods','timeCalc','estimateProcurement','estimateCosts','estimateSave']}/></article>
        <article><h3>Надёжность</h3><ul class="fact-list"><li>Команды идемпотентны по request ID; квитанции и CAS по ревизии цикла исключают двойную публикацию.</li><li>После рестарта <code>recover_cycles</code> помечает неопределённые попытки <code>interrupted</code>; модели автоматически не вызываются.</li><li>Сбой D001 никогда не запускает прежний генератор; <code>METALL_MVP_AUTOMATIC_PIPELINE=legacy</code> влияет только на последующие загрузки.</li></ul><SourceLinks ids={['cycleApi','cycleControl','recover','autoContinue','automaticSetting']}/></article>
      </div>
    </div></section>

    <section class="section" id="agents"><div class="wrap"><p class="eyebrow">04 / Роли</p><h2>Условия, входы и выходы</h2><div class="agents-controls"><div class="filter-chips" aria-label="Фильтр ролей"><button data-agent-filter="all" aria-pressed="true">Все роли</button><button data-agent-filter="llm" aria-pressed="false">Вызовы модели</button><button data-agent-filter="code" aria-pressed="false">Обычный код</button></div><span class="muted" id="agent-count">{agents.length} ролей</span></div><div class="agents-table">{agents.map((a,i)=><details class="agent-row" data-agent-kind={a.kind==='Детерминированный'?'code':'llm'}><summary><span class="agent-number">{String(i+1).padStart(2,'0')}</span><span class="agent-summary"><span class="agent-title">{a.name}</span><span class="agent-name">{a.role}</span></span><span class:list={['badge',{agent:a.kind!=='Детерминированный'}]}>{a.kind}</span><span class="expand-mark" aria-hidden="true">+</span></summary><div class="agent-body"><dl><div><dt>Условие запуска</dt><dd>{a.when}</dd></div><div><dt>Вход</dt><dd>{a.input}</dd></div><div><dt>Выход</dt><dd>{a.output}</dd></div></dl><SourceLinks ids={a.sources}/></div></details>)}</div>
      <details class="bounded-detail"><summary>Провайдер и модель <span aria-hidden="true">+</span></summary><p>Провайдер и модель выбираются конфигурацией и профилем; поддержаны API и CLI-провайдеры. Для ролей цикла provider/model/effort закрепляются при создании цикла. Фактические параметры, usage и длительность каждого вызова пишутся в trace. CLI-провайдер получает рабочий каталог с файлами задания.</p><SourceLinks ids={['providers','providerResolve','llm','cliWorkspace','rolePin']}/></details>
      <details class="bounded-detail"><summary>Прежний автоматический маршрут <span aria-hidden="true">+</span></summary><p>Прежний генератор маршрута с собственными временем и сметой сохранён для старых запусков, режима <code>legacy</code> и отдельного API <code>/pipeline/*</code>. В новом цикле он не вызывается и не служит запасным вариантом; его таблицы новые циклы не используют.</p><SourceLinks ids={['routeCall','routeSave','routeJobs','alternate','methodology']}/></details>
    </div></section>

    <section class="section wash" id="data"><div class="wrap"><p class="eyebrow">05 / Хранение</p><h2>JSON-паспорт и SQL-схемы</h2><p class="technical-lead">SQL-метаданные, файловые артефакты и CSV-проекции различаются. Схемы ниже извлечены из объявлений кода; рабочие базы не читались.</p><div class="storage-tabs tabs" role="tablist" aria-label="Группа данных">{storageGroups.map(g=><button role="tab" data-storage={g.id} aria-selected={g.id==='passport'?'true':'false'} aria-controls="storage-panel" id={'storage-tab-'+g.id} tabindex={g.id==='passport'?0:-1}>{labels[g.id]}</button>)}</div><div id="storage-panel" role="tabpanel" aria-labelledby="storage-tab-passport" class="storage-panel"><div class="storage-intro"><div><p class="eyebrow">Форма записи</p><h3 id="storage-name"></h3><p id="storage-description"></p></div><div><span class="muted">Путь по умолчанию</span><code id="storage-path"></code><p class="caption">Пути настраиваются. Это конфигурация кода, без чтения рабочих баз.</p></div></div><div id="storage-content"></div><div id="storage-sources"></div></div><details class="bounded-detail"><summary>Файл и SQL-метаданные <span aria-hidden="true">+</span></summary><div class="artifact-flow"><div><code>processing_runs.id</code><span>Запуск обработки</span></div><i aria-hidden="true">→</i><div><code>artifacts.run_id → object_ref</code><span>Тип, размер, SHA-256, span_id</span></div><i aria-hidden="true">→</i><div><code>{`{run_id}/{uuid}-{kind}.json`}</code><span>Паспорт, пакеты и публикации ролей</span></div></div><p>Паспорт, пакеты ролей, публикации и выгрузки — файлы; SQL хранит ссылки, контрольные суммы и ревизии. При чтении артефакта код сверяет SHA-256.</p><SourceLinks ids={['artifacts','trace','cycleSchema']}/></details></div></section>

    <section class="section" id="sources"><div class="wrap"><p class="eyebrow">06 / Проверяемое основание</p><h2>Фрагменты исходников</h2><p>Источник: <code>F:\projects\metall-dev-2</code>, <code>{audit.branch}</code> · <code>{audit.head.slice(0,7)}</code>. Фрагменты привязаны к тексту строк и пересчитываются при обновлении снимка; Go-файлы взяты из того же коммита.</p><div class="source-search"><label for="source-query">Найти основание</label><input id="source-query" type="search" placeholder="Цикл, роль, паспорт, repository…"/><a href="/architecture.json" download class="secondary-button">Скачать данные ↓</a><button class="secondary-button" id="print-page">Печать</button></div><p id="source-result-count" class="caption" aria-live="polite"></p><div class="source-catalog" id="source-catalog">{Object.values(sources).map((s,i)=><button class="source-entry" hidden={i>=8} data-source={s.id} data-search={(s.title+' '+s.path).toLowerCase()}><span><b>{s.title}</b><code>{s.path}:{s.start}–{s.end}</code></span><span aria-hidden="true">↗</span></button>)}</div><p id="source-empty" hidden>По этому запросу источников нет.</p><button class="secondary-button" id="expand-sources" aria-expanded="false" aria-controls="source-catalog">Показать все основания ↓</button></div></section>
  </main>
  <footer><div class="wrap footer-inner"><span>Подготовка производства / Технический разбор</span><a href="/plan/">Общий план ↗</a><a href="/">К презентации ↗</a></div></footer>
  <dialog id="source-dialog" aria-labelledby="source-dialog-title"><div class="dialog-top"><p class="eyebrow">Основание из снимка</p><button type="button" class="close-button" id="close-source" aria-label="Закрыть фрагмент"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div><h2 id="source-dialog-title"></h2><p id="source-dialog-path" class="mono"></p><div class="dialog-meta"><span>SHA-256 всего файла</span><code id="source-dialog-hash"></code></div><pre id="source-dialog-code" tabindex="0"></pre><p class="caption">Номера строк относятся к сохранённому снимку. Рабочий репозиторий не запрашивается.</p></dialog>
  <div id="toast" role="status" aria-live="polite" hidden></div>
  <script src="../scripts/atlas.ts"></script>
</body>
</html>
