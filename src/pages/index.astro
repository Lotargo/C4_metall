---
import data from '../data/evidence.json';
import screenshots from '../data/screenshots.json';
import { outcomes, stepStories, recognitionPhases, roleStories, dataDestinations, geometryColumns } from '../data/presentation.mjs';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import { stepTitles, stepConditions, businessRoles, businessLocations } from '../data/business.mjs';
import '../styles/global.css';
const { steps, agents } = data;
const hero = screenshots[0];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Подготовка производства — от чертежа к решению технолога</title>
  <meta name="description" content="Понятный разбор подготовки производства: как читается чертёж, работают агенты, формируется паспорт и сохраняются результаты. Скриншоты интерфейса и проверяемые основания." />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f6f2" />
  <meta property="og:title" content="Подготовка производства — от чертежа к решению технолога" />
  <meta property="og:description" content="Презентация реализованного процесса: распознавание, заготовка, предварительный маршрут и контроль человеком." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">ПП</span><span>Подготовка<br/>производства</span></a>
      <nav aria-label="Разделы"><a href="#pipeline">Процесс</a><a href="#recognition">Распознавание</a><a href="#agents">Агенты</a><a href="#data">Данные</a></nav>
      <a class="audience-link" href="/it/" target="_blank" rel="noopener" aria-label="Для IT-специалистов — в новой вкладке">Для IT <span aria-hidden="true">↗</span></a>
      <a class="audience-link voksa-link" href="/voksa/" target="_blank" rel="noopener" aria-label="Разбор ВоксаТех — в новой вкладке"><span class="wide-label">Разбор </span>ВоксаТех <span aria-hidden="true">↗</span></a>
      <button class="secondary-button presentation-trigger" id="start-presentation" aria-pressed="false">Режим показа <span aria-hidden="true">↗</span></button>
    </div>
  </header>
  <main id="main">
    <section class="chapter hero" id="top" data-chapter="О продукте">
      <div class="wrap">
        <p class="eyebrow">Для руководства и инвесторов</p>
        <div class="hero-layout">
          <div class="hero-copy">
            <h1>От чертежа<br/>к решению<br/><span>технолога.</span></h1>
            <p class="lead">Система читает чертёж, собирает паспорт детали и готовит основу для выбора заготовки и операций.</p>
            <p class="hero-context">Технолог получает сведения, предложения и их основания в одном процессе. Решение о пригодности остаётся за специалистом.</p>
            <a class="primary-button" href="#pipeline">Как устроен процесс <span aria-hidden="true">↓</span></a>
          </div>
          <figure class="hero-figure">
            <div class="figure-heading"><span>Рабочий интерфейс</span><a href="#screens">{screenshots.length} экранов продукта <span aria-hidden="true">↗</span></a></div>
            <button class="screenshot-button" data-image={hero.id} aria-label={'Увеличить скриншот: ' + hero.title}><img src={hero.file} width={hero.width} height={hero.height} alt="Рабочее пространство: исходный чертёж с зонами распознавания и инженерный паспорт рядом" fetchpriority="high" /></button>
            <figcaption>{hero.title}: технолог сверяет паспорт с исходным листом. Скриншот интерфейса от {hero.date}.</figcaption>
          </figure>
        </div>
        <div class="outcomes">{outcomes.map((o,i)=><article><span class="ordinal">0{i+1}</span><h3>{o.title}</h3><p>{o.text}</p></article>)}</div>
        <p class="chapter-footnote">Описание системы на 13 октября 2026. Маршрут предварительный; готовая смета и инженерная приёмка — отдельные результаты.</p>
      </div>
    </section>

    <section class="chapter section wash" id="pipeline" data-chapter="Весь процесс"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">01 / Весь процесс</p><h2>Один чертёж.<br/>Восемь шагов.</h2></div><p class="section-intro">Сначала — факты о детали. Затем — справочные данные и предложения по изготовлению. В конце — рассмотрение технологом.</p></div>
      <div class="journey-summary" aria-label="Основная последовательность"><span>Чертёж</span><i aria-hidden="true">→</i><span>Паспорт</span><i aria-hidden="true">→</i><span>Заготовка</span><i aria-hidden="true">→</i><span>Маршрут</span><i aria-hidden="true">→</i><span>Технолог</span></div>
      <div class="pipeline-layout"><div class="step-list" role="tablist" aria-label="Этапы процесса" aria-orientation="vertical">{steps.map((s,i)=><button class:list={['step-button',{active:i===0}]} role="tab" aria-selected={i===0?'true':'false'} aria-controls={'step-panel-'+s.id} id={'step-tab-'+s.id} tabindex={i===0?0:-1} data-step={s.id}><span class="step-number">{String(i+1).padStart(2,'0')}</span><span>{s.id==='nsi'?'Допуски и справочники':s.name}</span><span class="step-chevron" aria-hidden="true">→</span></button>)}</div>
      <div class="step-panels">{steps.map((s,i)=><article role="tabpanel" aria-labelledby={'step-tab-'+s.id} id={'step-panel-'+s.id} hidden={i!==0} class="step-panel"><div class="step-panel-top"><span class="badge">{s.tag==='Vision'?'Модель ИИ':s.tag==='Код + агент'?'Программа + агент':s.tag==='Агент'?'Модель ИИ':s.tag==='Алгоритм'?'Расчёт':s.tag==='UI + версии'?'Технолог + программа':'Программа'}</span><span class="muted">Шаг {i+1} из 8</span></div><h3>{stepTitles[s.id]}</h3><p class="step-story">{stepStories[s.id].text}</p><div class="output-box"><span>Что получаем</span><p>{stepStories[s.id].result}</p></div><details class="technical-detail"><summary>Условия и ограничения</summary><p>{stepConditions[s.id]}</p></details></article>)}</div></div>
      <details class="bounded-detail"><summary>Что происходит, если данных не хватает или возникла ошибка <span aria-hidden="true">+</span></summary><p>Некорректный файл, ошибка сервиса чтения, исчерпанный лимит попыток или проблема справочных данных сохраняются в диагностике. Неопределённость показывается технологу. Переход к следующему шагу определяется готовностью сведений и правилами процесса: статус «требует проверки» сам по себе не означает остановку любой дальнейшей работы.</p><p>Планировщик в соответствующем режиме может предложить заготовку без расчётно выбранного круга. При этом автоматическое продолжение всё ещё зависит от подготовки паспорта и справочного контекста.</p></details>
    </div></section>

    <section class="chapter section" id="recognition" data-chapter="Распознавание"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">02 / Распознавание чертежа</p><h2>Прочитать лист.<br/>Сохранить смысл.</h2></div><p class="section-intro">Модель читает изображение, а программа собирает и проверяет результат. Факт с чертежа, расчёт и предположение должны оставаться различимыми.</p></div>
      <div class="method-strip">{recognitionPhases.map((p,i)=><article><span class="method-number">0{i+1}</span><p class="method-owner">{p.owner}</p><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>
      <div class="reading-principle"><div><h3>В результате важно<br/>не потерять источник.</h3><p>Паспорт хранит исходную надпись, ссылки на свидетельства и статус. Если значение не прочитано, оно остаётся неизвестным. Если источники расходятся, конфликт сохраняется.</p></div><div class="fact-record"><p class="eyebrow">Что сопровождает факт</p><dl><div><dt>Буквальная запись</dt><dd>Сохраняется дословно</dd></div><div><dt>Связь с источником</dt><dd>Можно сверить с источником</dd></div><div><dt>Сторона поверхности</dt><dd>Наружная, внутренняя или не установлена</dd></div><div><dt>Неизвестное значение</dt><dd>Помечается как неизвестное</dd></div><div><dt>Противоречия</dt><dd>Показываются отдельно</dd></div></dl><p class="caption">Так сохраняется происхождение и определённость сведений.</p></div></div>
      <details class="bounded-detail reading-method"><summary>Подробнее: как система читает чертёж <span aria-hidden="true">+</span></summary><ol><li><b>Готовит два изображения.</b> Обзор нужен для чтения всей детали, подробная копия — для мелких надписей. Исходный документ сохраняется отдельно.</li><li><b>Задаёт правила чтения.</b> Модель получает изображение и инструкцию: сначала прочитать надпись дословно, затем определить, к какой поверхности она относится. Принадлежность устанавливается по выносным линиям и границам участка, а не по соседству. Вид или разрез — это изображение, а не новая поверхность.</li><li><b>Даёт рассмотреть мелкие надписи.</b> Если модель подключена через агентную среду, ей доступно подробное изображение листа, и она может увеличить нужную область. Размеры по пикселям не измеряются; неразборчивое остаётся неизвестным.</li><li><b>Возвращает сведения в заданной структуре.</b> Для каждой поверхности указаны сторона — наружная, внутренняя или не установлена — и роль: готовая деталь, заготовка или расположение. Равные диаметры разных поверхностей не объединяются.</li><li><b>Уточняет найденные пропуски.</b> В обычном режиме агент может получить увеличенный фрагмент и уже известные факты. Количество попыток ограничено. Есть отдельный режим чтения с журналом наблюдений; он работает без этой ветки уточнений.</li><li><b>Собирает и проверяет паспорт.</b> Программа связывает факты с источником, проверяет ссылки и покрытие, готовит таблицу размеров и отчёт. Диаметры, названные в описании модели, но не привязанные к поверхности, выносятся вопросами для технолога.</li></ol><p><b>Что требует проверки человеком.</b> Правила чтения не гарантируют точность результата. Для части аннотаций область источника может охватывать весь лист; она не доказывает точное расположение надписи. Непрочитанные значения, неустановленная сторона, конфликты и открытые упоминания сохраняются для разбора.</p></details>

    </div></section>

    <section class="chapter section wash" id="screens" data-chapter="Интерфейс"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">03 / Интерфейс продукта</p><h2>Данные, с которыми<br/>работает технолог.</h2></div><p class="section-intro">Скриншоты реального интерфейса: обработка чертежа, паспорт и поверхности, карта маршрута, справочник и оборудование. Выберите экран и откройте его в полном размере.</p></div>
      <div class="screen-tabs tabs" role="tablist" aria-label="Скриншоты продукта">{screenshots.map((s,i)=><button role="tab" data-screen={s.id} aria-selected={i===0?'true':'false'} id={'screen-tab-'+s.id} aria-controls={'screen-panel-'+s.id} tabindex={i===0?0:-1}>{s.title}</button>)}</div>
      {screenshots.map((s,i)=><article class="screen-panel" id={'screen-panel-'+s.id} role="tabpanel" aria-labelledby={'screen-tab-'+s.id} hidden={i!==0}><figure><button class:list={['screenshot-button',{'crop-focus':!!s.focusY}]} data-image={s.id} aria-label={'Увеличить: '+s.title}><img src={s.file} width={s.width} height={s.height} alt={s.title} loading="lazy" style={s.focusY ? 'object-position:center '+s.focusY : undefined} /></button><figcaption>Скриншот от {s.date} · <button class="text-button" data-image={s.id}>Открыть в полном размере ↗</button></figcaption></figure><div class="screen-story"><p class="eyebrow">Что здесь происходит</p><h3>{s.point}</h3><p>{s.text}</p></div></article>)}
      <p class="chapter-footnote">Экраны взяты из материалов проверки продукта и скопированы без редактирования: обработка, паспорт, поверхности и маршрут — от 13 октября, справочник и каталог оборудования — от 1 и 9 октября. Утверждения о процессе основаны на снимке кода от 13 октября. Контрольные записи проверки подписаны; количество записей на экранах не описывает текущие рабочие базы.</p>
    </div></section>

    <section class="chapter section" id="agents" data-chapter="Агенты"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">04 / Исполнители</p><h2>У каждого агента<br/>своя задача.</h2></div><p class="section-intro">Модели читают и предлагают. Программа собирает данные и выполняет заданные проверки. Технолог рассматривает результат и сохраняет свои изменения.</p></div>
      <div class="agents-controls"><div class="filter-chips" aria-label="Фильтр ролей"><button data-agent-filter="all" aria-pressed="true">Все роли</button><button data-agent-filter="llm" aria-pressed="false">Вызовы модели</button><button data-agent-filter="code" aria-pressed="false">Обычный код</button></div><span class="muted" id="agent-count">{agents.length} ролей</span></div>
      <div class="agents-table">{agents.map((a,i)=><details class="agent-row" data-agent-kind={a.kind==='Детерминированный'?'code':'llm'}><summary><span class="agent-number">{String(i+1).padStart(2,'0')}</span><span class="agent-summary"><span class="agent-title">{roleStories[i].title}</span><span class="agent-name">{businessRoles[i].name}</span></span><span class:list={['badge',{agent:a.kind!=='Детерминированный'}]}>{a.kind==='Детерминированный'?'Программа':'Модель'}</span><span class="expand-mark" aria-hidden="true">+</span></summary><div class="agent-body"><dl><div><dt>Когда запускается</dt><dd>{businessRoles[i].when}</dd></div><div><dt>Что получает</dt><dd>{businessRoles[i].input}</dd></div><div><dt>Что возвращает</dt><dd>{businessRoles[i].output}</dd></div></dl></div></details>)}</div>
      <details class="bounded-detail"><summary>Всегда ли участвуют все агенты <span aria-hidden="true">+</span></summary><p>Сверка описания, сборка паспорта и представление проверки выполняются программой. Уточнение чтения и исследование материала включаются при определённых условиях. Пояснение подбора и дополнительный анализ запускаются по отдельному запросу.</p><p>Модель выбирается настройками системы. Для каждого вызова сохраняются сведения о том, какая модель участвовала и что вернула. Подробное техническое устройство доступно во вкладке для IT-специалистов.</p></details>
    </div></section>

    <section class="chapter section wash" id="data" data-chapter="Данные"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">05 / Данные и хранение</p><h2>Паспорт хранит сведения.<br/>Таблица помогает их проверить.</h2></div><p class="section-intro">Сведения о детали сохраняются вместе с происхождением и историей изменений. Таблица делает размеры и требования удобными для проверки. Оригинал и результаты обработки остаются связанными.</p></div>
      <div class="geometry-intro"><h3>Как устроена таблица геометрии</h3><p>Одна строка соответствует одному размеру из паспорта детали. Это может быть наружный или внутренний диаметр, линейный размер, радиус, угол, толщина либо другой размер.</p></div>
      <div class="table-scroll geometry-table"><table><caption>Пять колонок таблицы. Здесь объясняется их смысл, без чисел конкретного чертежа.</caption><thead><tr>{geometryColumns.map(c=><th scope="col">{c[0].startsWith('Без заголовка')?'Что измерено':c[0]}</th>)}</tr></thead><tbody><tr>{geometryColumns.map(c=><td>{c[1]}</td>)}</tr></tbody></table></div>
      <p class="caption">Каждая строка связана с исходными сведениями. «Наружный» или «внутренний» диаметр пишется только при подтверждённой стороне поверхности; иначе подпись говорит, что сторона не установлена. Размеры заготовки и расположения отверстий подписаны отдельно и в расчёт детали не входят.</p>
      <div class="destination-list">{dataDestinations.map((d,i)=><article><span class="ordinal">0{i+1}</span><div><h3>{d.title}</h3><p>{d.meaning}</p></div><div><span class="business-location">{businessLocations[i]}</span></div></article>)}</div>
      <details class="bounded-detail"><summary>Что происходит при изменении данных <span aria-hidden="true">+</span></summary><p>Правки паспорта, включая решения по поверхностям, сохраняются как новые версии с основанием. Отметка о сверке с оригиналом отличает подтверждённое решение от ручного дополнения. В справочнике фиксируется активная версия таблицы; изменения через интерфейс и CSV проходят через один сервис. Предложение агента и пользовательские правки маршрута сохраняются отдельно, чтобы можно было проследить принятое решение.</p></details>
    </div></section>

    <section class="chapter section" id="sources" data-chapter="Границы результата"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">06 / Границы результата</p><h2>Система готовит основу.<br/>Технолог принимает решение.</h2></div><p class="section-intro">Для дальнейшей работы важно видеть исходные факты, предложения и ограничения. Человек проверяет их применимость к конкретной детали и производству.</p></div>
      <div class="limits"><article><h3>Выбор заготовки</h3><p>Назначение на чертеже и рассчитанная альтернатива сохраняются отдельно. Кривизна из справочника — расчётный параметр, а не измерение конкретного прутка.</p></article><article><h3>Готовность маршрута</h3><p>Маршрут содержит предложения и условия. Масса на этапах — плановая оценка. Завершение задания агента подтверждает окончание его работы; инженерная приёмка и готовая смета требуют отдельного результата.</p></article><article><h3>Качество чтения</h3><p>Паспорт помогает проверить результат по исходному чертежу. Качество распознавания и работа выбранной модели оцениваются на конкретном запуске.</p></article></div>
      <div class="business-conclusion"><h3>Что получает заказчик</h3><p>Паспорт детали, результат проверки заготовки и предварительные операции с основаниями. Технолог может рассмотреть их, исправить сведения и сохранить историю изменений.</p><p class="caption">Описание системы на 13 октября 2026. Скриншоты показывают интерфейс на подписанные даты. Инженерная приёмка не заменяется автоматическим результатом.</p><div class="conclusion-links"><a class="secondary-button" href="/it/" target="_blank" rel="noopener">Технический разбор для IT-специалистов ↗</a><a class="secondary-button" href="/voksa/" target="_blank" rel="noopener">Сравнение с ВоксаТех ↗</a></div></div>
    </div></section>
  </main>
  <footer><div class="wrap footer-inner"><span>Подготовка производства</span><span>Описание реализации · 13 октября 2026</span><a href="#top">Наверх ↑</a></div></footer>
