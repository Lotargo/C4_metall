---
import { sitePath } from '../utils/site-path.mjs';
import productScreens from '../data/screenshots.json';
import cycleScreens from '../data/cycle-screens.json';
import { recognitionPhases, geometryColumns } from '../data/presentation.mjs';
import { outcomes, steps, overallFlow, cycleFlow, principles, roles, destinations } from '../data/process.mjs';
import { anatomy, skillFlow, pinnedFlow, approaches, tradeoffs, instructions, kindLabel, skillUse } from '../data/instructions.mjs';
import manifest from '../data/instructions-manifest.json';
import Flow from '../components/Flow.astro';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '../styles/global.css';
import '../styles/flow.css';
// Screens of the passport, references and equipment, then the cycle to estimate.
const screenshots = [...productScreens.filter((s) => ['workspace', 'tables', 'catalogue'].includes(s.id)), ...cycleScreens];
const hero = screenshots[0];
const llmCount = roles.filter((r) => r.kind === 'llm').length;
const badge = { 'Технолог': 'human', 'ИИ-агенты': 'model', 'ИИ-агент': 'model', 'Программа': 'code' };
const files = manifest.files;
const chars = (n) => n.toLocaleString('ru-RU') + ' знаков';
const totalChars = (i) => i.files.filter(([k]) => k !== 'reader-full').reduce((sum, [k]) => sum + files[k].chars, 0);
const skillChars = ['rotational', 'sheet-metal', 'weldment'].reduce((sum, k) => sum + files['skill-geometry-' + k].chars, 0);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Подготовка производства — от чертежа до сметы</title>
  <meta name="description" content="Как «Подготовка производства» проводит деталь от чертежа до предварительной сметы: чтение листа, паспорт, заготовка, маршрут, проработка операций, время и смета. Роли ИИ-агентов и решения технолога." />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f6f2" />
  <meta property="og:title" content="Подготовка производства — от чертежа до сметы" />
  <meta property="og:description" content="Команда ИИ-агентов читает чертёж, строит маршрут и оценивает время; программа проверяет ответы и считает смету; технолог принимает решения." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">ПП</span><span>Подготовка<br/>производства</span></a>
      <nav aria-label="Разделы"><a href="#pipeline">Процесс</a><a href="#agents">Агенты</a><a href="#instructions">Инструкции</a><a href="#recognition">Чтение</a><a href="#data">Данные</a></nav>
      <a class="audience-link" href={sitePath('/it/')} target="_blank" rel="noopener" aria-label="Для IT-специалистов — в новой вкладке">Для IT <span aria-hidden="true">↗</span></a>
      <a class="audience-link plan-link" href={sitePath('/plan/')} target="_blank" rel="noopener" aria-label="Общий план — в новой вкладке"><span class="wide-label">Общий </span>план <span aria-hidden="true">↗</span></a>
      <a class="audience-link voksa-link" href={sitePath('/voksa/')} target="_blank" rel="noopener" aria-label="Разбор ВоксаТех — в новой вкладке"><span class="wide-label">Разбор </span>ВоксаТех <span aria-hidden="true">↗</span></a>
      <button class="secondary-button presentation-trigger" id="start-presentation" aria-pressed="false">Режим показа <span aria-hidden="true">↗</span></button>
    </div>
  </header>
  <main id="main">
    <section class="chapter hero" id="top" data-chapter="О продукте">
      <div class="wrap">
        <p class="eyebrow">Для руководства и инвесторов</p>
        <div class="hero-layout">
          <div class="hero-copy">
            <h1>От чертежа<br/>до сметы —<br/><span>с технологом.</span></h1>
            <p class="lead">Система читает чертёж, собирает паспорт детали, подбирает заготовку, строит маршрут, прорабатывает операции, оценивает время и собирает предварительную смету.</p>
            <p class="hero-context">Работу ведёт команда ИИ-агентов, у каждого — своя узкая задача. Программа проверяет каждый их ответ и выполняет все расчёты. Технолог видит основания, отвечает на вопросы и принимает решения.</p>
            <a class="primary-button" href="#pipeline">Как устроен процесс <span aria-hidden="true">↓</span></a>
          </div>
          <figure class="hero-figure">
            <div class="figure-heading"><span>Рабочий интерфейс</span><a href="#screens">{screenshots.length} экранов продукта <span aria-hidden="true">↗</span></a></div>
            <button class="screenshot-button" data-image={hero.id} aria-label={'Увеличить скриншот: ' + hero.title}><img src={sitePath(hero.file)} width={hero.width} height={hero.height} alt="Рабочее пространство: исходный чертёж с зонами распознавания и инженерный паспорт рядом" fetchpriority="high" /></button>
            <figcaption>{hero.title}: технолог сверяет паспорт с исходным листом. Скриншот интерфейса от {hero.date}.</figcaption>
          </figure>
        </div>
        <div class="outcomes">{outcomes.map((o, i) => <article><span class="ordinal">0{i + 1}</span><h3>{o.title}</h3><p>{o.text}</p></article>)}</div>
        <p class="chapter-footnote">Описание работы системы на 22 октября 2026. Основной сценарий — детали из круглого проката. Смета предварительная: она помогает технологу и не заменяет производственную приёмку.</p>
      </div>
    </section>

    <section class="chapter section wash" id="pipeline" data-chapter="Весь процесс"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">01 / Весь процесс</p><h2>Один чертёж.<br/>Одна цепочка до сметы.</h2></div><p class="section-intro">Агенты читают и предлагают, программа хранит, проверяет и считает, технолог решает там, где без него нельзя. Схема показывает, кто за что отвечает на каждом шаге.</p></div>
      <Flow id="flow-overall" label="Путь детали от чертежа до сметы: кто выполняет каждый шаг" {...overallFlow} />
      <p class="flow-note">Пунктир — шаги по необходимости: технолог правит паспорт, описывает операции без своего агента и задаёт цены. Ромб — точка решения: если заготовка не проходит проверку, цепочка ждёт выбора технолога.</p>

      <div class="pipeline-layout process-steps"><div class="step-list" role="tablist" aria-label="Шаги процесса" aria-orientation="vertical">{steps.map((s, i) => <button class:list={['step-button', { active: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={'step-panel-' + s.id} id={'step-tab-' + s.id} tabindex={i === 0 ? 0 : -1} data-step={s.id}><span class="step-number">{String(i + 1).padStart(2, '0')}</span><span>{s.name}</span><span class="step-chevron" aria-hidden="true">→</span></button>)}</div>
      <div class="step-panels">{steps.map((s, i) => <article role="tabpanel" aria-labelledby={'step-tab-' + s.id} id={'step-panel-' + s.id} hidden={i !== 0} class="step-panel"><div class="step-panel-top"><span class={'badge who-' + (badge[s.who.split(' ')[0]] ?? 'code')}>{s.who}</span><span class="muted">Шаг {i + 1} из {steps.length}</span></div><h3>{s.title}</h3><p class="step-story">{s.text}</p><div class="output-box"><span>Что получаем</span><p>{s.result}</p></div><details class="technical-detail"><summary>Условия и ограничения</summary><p>{s.conditions}</p></details></article>)}</div></div>
      <details class="bounded-detail"><summary>Что происходит, если данных не хватает <span aria-hidden="true">+</span></summary><p>Цепочка не останавливается целиком из-за одного неизвестного значения. Пробел ограничивает только то, что от него зависит: нет нормы отрезки — неизвестна длина отрезка и его масса; нет времени для шлифования — неизвестна стоимость этой операции. Остальное считается дальше.</p><p>Работа ждёт технолога только там, где нужен его выбор: спорная заготовка, операция без своего агента, запрос агента на пересмотр маршрута. После ответа цикл продолжается с затронутого шага. Обычное сохранение правки, открытие истории или обновление страницы агентов не запускают.</p></details>
    </div></section>

    <section class="chapter section" id="agents" data-chapter="Агенты"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">02 / Как работают агенты</p><h2>Команда агентов.<br/>У каждого — одна задача.</h2></div><p class="section-intro">От маршрута до сметы агенты работают эстафетой: планировщик раздаёт задания, профильные агенты прорабатывают операции по очереди, агент времени оценивает работу, программа считает деньги.</p></div>
      <Flow id="flow-cycle" label="Эстафета агентов от маршрута до сметы" {...cycleFlow} />
      <p class="flow-note">Проверка ответа (ромб) стоит после каждого агента, на схеме она показана один раз. Ответ, не прошедший проверку, в результат не попадает; повтор с замечаниями запускается явно и в пределах заданного лимита.</p>

      <div class="principles">{principles.map((p, i) => <article><span class="ordinal">{String(i + 1).padStart(2, '0')}</span><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>

      <h3 class="roster-title">Кто есть кто</h3>
      <div class="agents-controls"><div class="filter-chips" aria-label="Фильтр ролей"><button data-agent-filter="all" aria-pressed="true">Все роли</button><button data-agent-filter="llm" aria-pressed="false">ИИ-агенты · {llmCount}</button><button data-agent-filter="code" aria-pressed="false">Программа · {roles.length - llmCount}</button></div><span class="muted" id="agent-count">{roles.length} ролей</span></div>
      <div class="agents-table">{roles.map((r, i) => <details class="agent-row" data-agent-kind={r.kind}><summary><span class="agent-number">{String(i + 1).padStart(2, '0')}</span><span class="agent-summary"><span class="agent-title">{r.title}</span><span class="agent-name">{r.name} · {r.stage}</span></span><span class:list={['badge', { agent: r.kind === 'llm' }]}>{r.kind === 'llm' ? 'ИИ-агент' : 'Программа'}</span><span class="expand-mark" aria-hidden="true">+</span></summary><div class="agent-body"><dl class="role-facts"><div><dt>Когда работает</dt><dd>{r.when}</dd></div><div><dt>Что получает</dt><dd>{r.input}</dd></div><div><dt>Что возвращает</dt><dd>{r.output}</dd></div><div><dt>Чего не делает</dt><dd>{r.limits}</dd></div></dl></div></details>)}</div>
      <details class="bounded-detail"><summary>Какая модель работает и сколько это стоит по ресурсам <span aria-hidden="true">+</span></summary><p>Модель для агентов выбирается настройками системы и закрепляется при запуске вместе с пределами: числом обращений к модели, объёмом текста и временем. Для каждого обращения сохраняются модель, ответ, расход и длительность, поэтому любой результат можно проследить до конкретного ответа агента.</p><p>Пример первого рабочего цикла на валу: маршрут, проработка операций и оценка времени — вместе с повторами отклонённых ответов — заняли восемь обращений к модели и около 25 минут её работы. Это пример одного запуска, а не норматив.</p></details>
    </div></section>

    <section class="chapter section wash" id="instructions" data-chapter="Инструкции агентов"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">03 / Инструкции агентов</p><h2>Инструкция —<br/>рабочее задание агента.</h2></div><p class="section-intro">Модель сама по себе ничего не знает о заводе, чертежах и правилах проекта. Всё, что агент должен сделать и чего делать нельзя, написано в его инструкции. Ниже — как инструкции устроены, зачем нужна каждая и их полные тексты.</p></div>

      <div class="instr-block">
        <h3>Что такое инструкция</h3>
        <p class="instr-lead">Проще всего думать об инструкции как о должностной инструкции нового сотрудника вместе с бланком отчёта. Сотрудник грамотный и начитанный, но каждый раз выходит как в первый день: ему нужно объяснить задачу, сказать, какие материалы он получит, какие правила действуют и в какой форме сдать результат. Агент получает инструкцию при каждом обращении — заново и целиком, поэтому от её текста напрямую зависит качество работы.</p>
        <div class="anatomy">{anatomy.map((a, i) => <article><span class="ordinal">{String(i + 1).padStart(2, '0')}</span><h4>{a.title}</h4><p>{a.text}</p></article>)}</div>
      </div>

      <div class="instr-block">
        <h3>Что такое skill-архитектура</h3>
        <div class="instr-two">
          <div>
            <p><b>Skill (навык)</b> — отдельная памятка, которую можно подключить к основной инструкции. Памятка «Тела вращения» объясняет, на что смотреть у вала: ступени, их длины, резьбы, фаски, посадки. Памятка «Листовые детали» — про толщину листа и контур.</p>
            <p><b>Skill-архитектура</b> — способ собирать инструкцию агента из частей: базовая инструкция плюс набор навыков. Это как должностная инструкция и методички по видам работ: методичку можно обновить или добавить, не переписывая всю инструкцию, а одну методичку можно выдать разным сотрудникам.</p>
          </div>
          <ol class="instr-steps">
            <li><b>Навык — это папка с памяткой и паспортом.</b> В паспорте: название, описание, версия, лицензия и от каких навыков он зависит.</li>
            <li><b>При запуске системы навыки проверяются.</b> Программа находит все папки, проверяет паспорта и вычисляет отпечаток содержимого — короткий код, который меняется при любой правке текста.</li>
            <li><b>Агенту положен свой набор навыков.</b> Он задан заранее. Если навык зависит от другого, программа подключит и его, сверив версию.</li>
            <li><b>Тексты склеиваются в один.</b> Сначала базовая инструкция, затем навыки под своими заголовками. Агент получает цельный текст.</li>
            <li><b>В историю записывается состав.</b> Какие навыки, каких версий и с какими отпечатками участвовали — поэтому любой результат можно связать с точным текстом.</li>
          </ol>
        </div>
        <Flow id="flow-skills" label="Рисунок — Как собирается составная инструкция" {...skillFlow} />
      </div>

      <div class="instr-block">
        <h3>Два подхода в системе</h3>
        <div class="approaches">{approaches.map((a) => <article><h4>{a.title}</h4><p class="approach-who">{a.who}</p><p>{a.text}</p><p class="approach-why"><b>Зачем так:</b> {a.why}</p></article>)}</div>
        <p class="flow-note">Агенту чтения сейчас передаётся текст около {chars(files['reader-full'].chars)}: {chars(files['reader-base'].chars)} — базовая инструкция, {chars(skillChars)} — три навыка по типам деталей, {chars(files['reader-rules'].chars)} — общие правила работы с источником; остальное — заголовки частей. У ролей маршрута — один файл на роль, от {chars(files['time'].chars)} у агента времени до {chars(files['blank'].chars)} у агента отрезки.</p>
        <Flow id="flow-pinned" label="Рисунок — Как закреплена инструкция роли маршрута" {...pinnedFlow} legend={false} />
        <div class="doc-table-wrap tradeoffs"><table><caption>Сравнение подходов</caption><thead><tr><th scope="col">Что сравниваем</th><th scope="col">Составная: база + навыки</th><th scope="col">Одна закреплённая инструкция</th></tr></thead><tbody>{tradeoffs.map(([what, a, b]) => <tr><th scope="row">{what}</th><td>{a}</td><td>{b}</td></tr>)}</tbody></table></div>
      </div>

      <div class="instr-block">
        <h3>Все инструкции агентов</h3>
        <p class="instr-lead">Тексты скопированы из продукта без правок — именно их получают агенты. Часть написана на английском: модели одинаково понимают оба языка, а служебные правила по-английски короче. Для масштаба: страница книги — около 1 800 знаков.</p>
        <div class="agents-table instr-list">{instructions.map((it, i) => <details class="agent-row"><summary><span class="agent-number">{String(i + 1).padStart(2, '0')}</span><span class="agent-summary"><span class="agent-title">{it.agent}</span><span class="agent-name">{it.stage} · {kindLabel[it.kind]} · {chars(totalChars(it))} · {it.lang}</span></span><span class:list={['badge', 'kind-' + it.kind]}>{kindLabel[it.kind]}</span><span class="expand-mark" aria-hidden="true">+</span></summary><div class="agent-body">
          <dl class="instr-facts"><div><dt>Зачем нужна</dt><dd>{it.purpose}</dd></div><div><dt>Главные правила</dt><dd><ul>{it.rules.map((r) => <li>{r}</li>)}</ul></dd></div></dl>
          <div class="instr-files"><span class="muted">Полный текст:</span>{it.files.map(([key, label]) => <span class="instr-file"><button type="button" class="secondary-button" data-instruction={key} data-label={it.agent + ' — ' + label}>{label} · {chars(files[key].chars)}</button><a href={sitePath(files[key].file)} download aria-label={'Скачать: ' + label}>Скачать</a></span>)}</div>
        </div></details>)}</div>
      </div>

      <div class="instr-block">
        <h3>Библиотека навыков</h3>
        <p class="instr-lead">Все навыки, которые есть в системе. Часть подключается в цепочке до сметы, часть относится к отдельным вспомогательным агентам.</p>
        <div class="doc-table-wrap tradeoffs"><table><thead><tr><th scope="col">Навык</th><th scope="col">Где используется</th><th scope="col">О чём</th><th scope="col">Текст</th></tr></thead><tbody>{manifest.skills.map((s) => <tr><th scope="row">{s.id}<span class="skill-version">версия {s.version}</span></th><td>{skillUse[s.id]?.[0]}</td><td>{skillUse[s.id]?.[1]}</td><td><button type="button" class="text-button" data-instruction={'skill-' + s.id} data-label={'Навык ' + s.id}>Открыть ↗</button></td></tr>)}</tbody></table></div>
        <p class="chapter-footnote">Тексты взяты из исходного продукта на 22 октября 2026 года. Отпечатки инструкций ролей маршрута совпадают с закреплёнными в системе.</p>
      </div>
    </div></section>

    <section class="chapter section" id="recognition" data-chapter="Чтение чертежа"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">04 / Чтение чертежа</p><h2>Прочитать лист.<br/>Сохранить смысл.</h2></div><p class="section-intro">Модель читает изображение, а программа собирает и проверяет результат. Факт с чертежа, расчёт и предположение должны оставаться различимыми.</p></div>
      <div class="method-strip">{recognitionPhases.map((p, i) => <article><span class="method-number">0{i + 1}</span><p class="method-owner">{p.owner}</p><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>
      <div class="reading-principle"><div><h3>В результате важно<br/>не потерять источник.</h3><p>Паспорт хранит исходную надпись, место на листе и статус. Если значение не прочитано, оно остаётся неизвестным. Если источники расходятся, конфликт сохраняется.</p></div><div class="fact-record"><p class="eyebrow">Что сопровождает факт</p><dl><div><dt>Буквальная запись</dt><dd>Сохраняется дословно</dd></div><div><dt>Место на листе</dt><dd>Можно открыть и сверить</dd></div><div><dt>Сторона поверхности</dt><dd>Наружная, внутренняя или не установлена</dd></div><div><dt>Неизвестное значение</dt><dd>Помечается как неизвестное</dd></div><div><dt>Противоречия</dt><dd>Показываются отдельно</dd></div></dl><p class="caption">Так сохраняется происхождение и определённость сведений.</p></div></div>
      <details class="bounded-detail reading-method"><summary>Подробнее: как система читает чертёж <span aria-hidden="true">+</span></summary><ol><li><b>Готовит два изображения.</b> Обзор нужен для чтения всей детали, подробная копия — для мелких надписей. Исходный документ сохраняется отдельно.</li><li><b>Задаёт правила чтения.</b> Сначала надпись читается дословно, затем определяется, к какой поверхности она относится. Принадлежность устанавливается по выносным линиям и границам участка, а не по соседству. Вид или разрез — это изображение, а не новая поверхность.</li><li><b>Даёт рассмотреть мелкие надписи.</b> Агент может увеличить нужную область и повернуть копию, чтобы прочитать боковой текст. Размеры по пикселям не измеряются; неразборчивое остаётся неизвестным.</li><li><b>Возвращает сведения в заданной форме.</b> Для каждой поверхности указаны сторона и роль: готовая деталь, заготовка или расположение. Равные диаметры разных поверхностей не объединяются.</li><li><b>Собирает и проверяет паспорт.</b> Программа связывает факты с листом, проверяет ссылки и покрытие, готовит таблицу размеров и отчёт. Упоминания размеров без привязки выносятся вопросами для технолога.</li></ol><p><b>Что требует проверки человеком.</b> Правила чтения не гарантируют точность результата: низкое разрешение, рукописный шрифт и повреждения листа ограничивают сам источник. Непрочитанные значения, неустановленная сторона и конфликты сохраняются для разбора и ручной правки.</p></details>
    </div></section>

    <section class="chapter section wash" id="screens" data-chapter="Интерфейс"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">05 / Интерфейс продукта</p><h2>Что видит<br/>технолог.</h2></div><p class="section-intro">Скриншоты реального интерфейса: паспорт, справочник, оборудование и цикл до сметы. Выберите экран и откройте его в полном размере.</p></div>
      <div class="screen-tabs tabs" role="tablist" aria-label="Скриншоты продукта">{screenshots.map((s, i) => <button role="tab" data-screen={s.id} aria-selected={i === 0 ? 'true' : 'false'} id={'screen-tab-' + s.id} aria-controls={'screen-panel-' + s.id} tabindex={i === 0 ? 0 : -1}>{s.title}</button>)}</div>
      {screenshots.map((s, i) => <article class="screen-panel" id={'screen-panel-' + s.id} role="tabpanel" aria-labelledby={'screen-tab-' + s.id} hidden={i !== 0}><figure><button class:list={['screenshot-button', { 'crop-focus': !!s.focusY }]} data-image={s.id} aria-label={'Увеличить: ' + s.title}><img src={sitePath(s.file)} width={s.width} height={s.height} alt={s.title} loading="lazy" style={s.focusY ? 'object-position:center ' + s.focusY : undefined} /></button><figcaption>Скриншот от {s.date} · {s.note} <button class="text-button" data-image={s.id}>Открыть в полном размере ↗</button></figcaption></figure><div class="screen-story"><p class="eyebrow">Что здесь происходит</p><h3>{s.point}</h3><p>{s.text}</p></div></article>)}
      <p class="chapter-footnote">Экраны скопированы из интерфейса продукта без редактирования. Паспорт — от 13 октября, справочник и оборудование — от 1 и 9 октября, цикл до сметы — от 22 октября, рабочая среда.</p>
    </div></section>

    <section class="chapter section" id="data" data-chapter="Данные"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">06 / Данные и хранение</p><h2>Всё хранится<br/>с происхождением.</h2></div><p class="section-intro">Паспорт, ответы агентов, правки технолога и версии сметы связаны между собой. Любой результат можно проследить до листа чертежа, справочника или решения человека.</p></div>
      <div class="geometry-intro"><h3>Как устроена таблица геометрии</h3><p>Одна строка соответствует одному размеру из паспорта детали. Это может быть наружный или внутренний диаметр, линейный размер, радиус, угол, толщина либо другой размер.</p></div>
      <div class="table-scroll geometry-table"><table><caption>Пять колонок таблицы. Здесь объясняется их смысл, без чисел конкретного чертежа.</caption><thead><tr>{geometryColumns.map((c) => <th scope="col">{c[0].startsWith('Без заголовка') ? 'Что измерено' : c[0]}</th>)}</tr></thead><tbody><tr>{geometryColumns.map((c) => <td>{c[1]}</td>)}</tr></tbody></table></div>
      <div class="destination-list">{destinations.map((d, i) => <article><span class="ordinal">0{i + 1}</span><div><h3>{d.title}</h3><p>{d.text}</p></div><div></div></article>)}</div>
      <details class="bounded-detail"><summary>Что происходит при изменении данных <span aria-hidden="true">+</span></summary><p>Правка паспорта, выбор заготовки, ручное описание операции, правка времени или цены сохраняются новой версией с автором и основанием. Результаты, которые зависели от изменённого, помечаются как требующие пересчёта; независимые остаются в силе. Новый цикл до сметы создаётся рядом с прежним и не затирает его.</p></details>
    </div></section>

    <section class="chapter section wash" id="sources" data-chapter="Границы результата"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">07 / Границы результата</p><h2>Система готовит смету.<br/>Технолог принимает решение.</h2></div><p class="section-intro">Цель цепочки — достаточная оценка, а не идеальная технология. Маршрут может быть неидеальным: его поправит технолог при производстве.</p></div>
      <div class="limits"><article><h3>Заготовка</h3><p>Назначение на чертеже, расчётная рекомендация и выбор технолога хранятся раздельно. Кривизна прутка — норматив стандарта, а не измерение конкретной партии. Основной сценарий — круглый прокат.</p></article><article><h3>Время и смета</h3><p>Время — расчётная оценка с обоснованием, а не цеховая норма. Цены и ставки задают люди. Если чего-то не хватает, смета частичная, а итог показан как «не определено».</p></article><article><h3>Качество чтения</h3><p>Паспорт помогает проверить результат по исходному листу. Неразборчивый чертёж — ограничение источника: такие места остаются неизвестными и правятся вручную.</p></article></div>
      <div class="business-conclusion"><h3>Что получает заказчик</h3><p>Паспорт детали, обоснованный выбор заготовки, маршрут с проработкой операций, оценку времени и предварительную смету на деталь и партию. Каждая строка показывает, откуда она взялась; технолог может исправить любое звено, и история изменений сохранится.</p><p class="caption">Описание работы системы на 22 октября 2026. Скриншоты показывают интерфейс на подписанные даты. Производственная приёмка не заменяется автоматическим результатом.</p><div class="conclusion-links"><a class="secondary-button" href={sitePath('/plan/')} target="_blank" rel="noopener">Общий план: входящие данные ↗</a><a class="secondary-button" href={sitePath('/it/')} target="_blank" rel="noopener">Технический разбор для IT-специалистов ↗</a><a class="secondary-button" href={sitePath('/voksa/')} target="_blank" rel="noopener">Сравнение с ВоксаТех ↗</a></div></div>
    </div></section>
  </main>
