---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductBanner from '../components/ProductBanner.astro';
import OverviewSection from '../components/OverviewSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { overviewSections } from '../utils/public-content';
import { sitePath } from '../utils/site-path.mjs';
import { drawings, drawingPath } from '../data/results.mjs';
import { resultImageSize } from '../utils/results-images.mjs';
import '../styles/global.css';
import '../styles/flow.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/metall.css';
import '../styles/interactive.css';
import '../styles/overview.css';
const sections = await overviewSections();
---
<!doctype html><html lang="ru"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Подготовка производства — от чертежа к решениям технолога</title>
  <meta name="description" content="Текущий путь работы с деталью: чтение чертежа, технический паспорт, заготовка, уточнения, маршрут и расчёт работ. Роли программы, ИИ и технолога, примеры и ограничения."/>
  <meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#f4f6f8"/>
  <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')}/><ThemeHead/>
</head><body>
  <a class="skip-link" href="#main">Перейти к содержанию</a><ThemeToggle/>
  <div class="metall-page" id="page-start">
    <SiteHeader page="home"><button type="button" class="secondary-button presentation-trigger" id="start-presentation" aria-pressed="false" aria-label="Режим показа"><Icon name="metrics"/><span data-presentation-label>Режим показа</span></button></SiteHeader>
    <main id="main">
      <section class="chapter hero" id="top" data-chapter="Обзор продукта"><div class="wrap"><ProductBanner/>
        <div class="hero-principles"><div><Icon name="tolerances"/><span><strong>Данные чертежа</strong>Факты и расчётные предположения различимы</span></div><div><Icon name="comparison"/><span><strong>Решения видимы</strong>Вопросы и неподтверждённые сведения сохраняются</span></div><div><Icon name="prepared"/><span><strong>Результат проверяем</strong>Технолог рассматривает паспорт и операции</span></div></div>
      </div></section>
      {sections.map((entry, index) => <OverviewSection entry={entry} index={index}/>)}
      <section class="chapter section" id="examples" data-chapter="Примеры интерфейса"><div class="wrap">
        <SectionHeading eyebrow="Примеры / Технические паспорта" title="Посмотреть, что получилось." icon="prepared">Три сохранённых примера в текущем интерфейсе. Каждый паспорт можно открыть целиком и прочитать без потери деталей.</SectionHeading>
        <div class="example-cards">{drawings.map(drawing => {
          const picture = drawing.sections.flatMap(s => s.evidence || [])[0];
          const size = resultImageSize(picture.src);
          return <a class="example-card" href={sitePath(drawingPath(drawing))}><div class="example-card-image"><img src={sitePath(picture.src)} alt={'Фрагмент технического паспорта: ' + drawing.title} loading="lazy" width={size.width} height={size.height}/></div><div class="example-card-copy"><span class="eyebrow">Паспорт детали</span><h3>{drawing.title}<span aria-hidden="true">↗</span></h3><p>{drawing.summary}</p><span class="example-card-action">Открыть длинный скриншот <Icon name="chevron"/></span></div></a>;
        })}</div>
        <p class="content-note">Скриншоты сделаны 13 ноября 2026 года на сохранённых результатах. Это иллюстрации интерфейса и конкретных примеров, а не новый запуск распознавания или подтверждение готовности всех расчётов.</p>
      </div></section>
    </main>
    <SiteFooter/>
    <div class="presentation-bar" id="presentation-bar" hidden><span id="chapter-status" role="status" aria-live="polite"></span><div><button type="button" id="chapter-prev" aria-label="Предыдущий раздел">←</button><button type="button" id="chapter-next" aria-label="Следующий раздел">→</button><button type="button" id="end-presentation">Завершить показ</button></div></div>
  </div>
  <script>import '../scripts/presentation';</script>
</body></html>
