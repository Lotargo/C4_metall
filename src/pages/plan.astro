---
import { sitePath } from '../utils/site-path.mjs';
import planScreens from '../data/plan-screens.json';
import { kinds, items, general } from '../data/plan.mjs';
import Flow from '../components/Flow.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '../styles/global.css';
import '../styles/flow.css';
import '../styles/plan.css';
const shots = Object.fromEntries(planScreens.map((s) => [s.id, s]));
const itemState = { done: 'done', partial: 'limited' };
const shapeOf = { source: 'doc', result: 'end' };
// Each item's data route as a left-to-right chain of flowchart shapes.
const chain = (route) => ({
  nodes: route.map((r, n) => ({ id: 'n' + n, col: n, kind: r.kind, shape: shapeOf[r.kind] ?? 'task', title: r.title, here: r.here })),
  edges: route.slice(1).map((_, n) => ({ from: 'n' + n, to: 'n' + (n + 1) })),
});
const states = { done: 'Работает', limited: 'Работает с ограничениями' };
const edition = '22 октября 2026';
const toc = { id: 'inputs', n: '1', title: 'Входящие данные', sub: items.map((i, k) => ({ id: i.id, n: '1.' + (k + 1), title: i.title })) };
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Входящие данные и примеры</title>
  <meta name="description" content="Шесть видов входящих данных: как работают, что проверено, как выглядят на экране и что не выполнено. Примеры от 19–22 октября 2026 года." />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f6f2" />
  <meta property="og:title" content="Входящие данные и примеры" />
  <meta property="og:description" content="Требования, поверхности, материал, заготовка, масса и база знаний «Станки»." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
  <ThemeHead />
</head>
<body class="plan-page">
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <ThemeToggle />
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={sitePath('/')}><span class="brand-mark" aria-hidden="true">ПП</span><span>Подготовка<br/>производства</span></a>
      <span class="doc-header-title">Входящие данные · редакция от {edition}</span>
      <button class="secondary-button doc-print" id="print-doc" type="button">Печать / PDF</button>
      <a class="audience-link" href={sitePath('/')}>К презентации <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <div class="wrap doc-layout">
    <aside class="doc-toc" role="navigation" aria-label="Содержание документа">
      <details class="doc-toc-box" open>
        <summary>Содержание</summary>
        <ol>
          <li>
            <a href={'#' + toc.id} data-toc={toc.id}><span class="toc-n">{toc.n}</span><span>{toc.title}</span></a>
            <ol>{toc.sub.map((t) => <li><a href={'#' + t.id} data-toc={t.id}><span class="toc-n">{t.n}</span><span>{t.title}</span></a></li>)}</ol>
          </li>
        </ol>
      </details>
    </aside>

    <main id="main" class="doc-sheet">
      <header class="doc-title" id="top">
        <p class="doc-kicker">Подготовка производства</p>
        <h1>Входящие данные и примеры</h1>
        <p>Сохранённые примеры интерфейса и проверок на указанные даты. Актуальный объём работ и готовность проекта приведены в <a href={sitePath('/implementation/')}>общем плане реализации</a>.</p>
        <table class="doc-meta">
          <tbody>
            <tr><th scope="row">Редакция</th><td>{edition}</td></tr>
            <tr><th scope="row">Основание</th><td>Рабочие документы и отчёты проверок проекта на 19–22 октября 2026 года.</td></tr>
            <tr><th scope="row">Обозначения</th><td><div class="doc-legend">{Object.entries(states).map(([k, v]) => <span class={'status status-' + k}>{v}</span>)}</div></td></tr>
          </tbody>
        </table>
      </header>

      <section id="inputs" class="doc-section">
        <h2><span class="sec-n">1</span>Входящие данные</h2>
        <p>Шесть видов данных, из которых складываются маршрут и смета детали. По каждому: как это работает, по какому пути идут данные, что показала проверка, как это выглядит на экране и что не выполнено. Скриншоты сделаны в настоящем интерфейсе во время проверок 19–21 октября; нажмите на снимок, чтобы открыть его в исходном размере.</p>
        <div class="doc-table-wrap">
          <table class="doc-table">
            <thead><tr><th scope="col" class="col-n">№</th><th scope="col">Входящие данные</th><th scope="col">Состояние</th></tr></thead>
            <tbody>{items.map((i, k) => <tr><td class="col-n">1.{k + 1}</td><th scope="row"><a href={'#' + i.id}>{i.title}</a></th><td><span class={'status status-' + itemState[i.state]}>{states[itemState[i.state]]}</span> <span class="muted">{i.stateLabel}</span></td></tr>)}</tbody>
          </table>
        </div>

        {items.map((i, k) => { const n = '1.' + (k + 1); return <article class="input-item" id={i.id}>
          <h3><span class="sec-n">{n}</span>{i.title}</h3>
          <p class="item-status"><span class={'status status-' + itemState[i.state]}>{states[itemState[i.state]]}</span><span>{i.stateLabel}</span></p>
          <p>{i.summary}</p>

          <h4>Как это работает</h4>
          <ol class="how-list">{i.how.map(([kind, t]) => <li><span class={'who kind-' + kind}>{kinds[kind]}</span><span>{t}</span></li>)}</ol>

          <h4>Путь данных</h4>
          <div class="route-chain"><Flow id={'route-' + i.id} label={'Путь данных: ' + i.title} {...chain(i.route)} legend={false} /></div>
          <ol class="route-steps">{i.route.map((r, m) => <li class:list={['kind-' + r.kind, { here: r.here }]}><span class="route-step-num">{m + 1}</span><span><b>{r.title}{r.here && ' — этот пункт'}.</b> {r.text}</span></li>)}</ol>

          <h4>Результаты проверки</h4>
          <ul class="result-list">{i.results.map((r) => <li>{r}</li>)}</ul>

          <h4>Как это выглядит</h4>
          <div class="shot-grid">{i.shots.map((id, m) => { const s = shots[id]; return <figure class="plan-shot"><button class="screenshot-button" data-image={s.id} aria-label={'Увеличить скриншот: ' + s.title}><img src={sitePath(s.file)} width={s.width} height={s.height} alt={s.title} loading="lazy" /></button><figcaption><b>Рисунок {n}.{m + 1} — {s.title}.</b> {s.note} <span class="shot-date">Снимок от {s.date}.</span></figcaption></figure>; })}</div>

          <h4>Что не выполнено и почему</h4>
          <div class="doc-table-wrap">
            <table class="doc-table not-done-table">
              <thead><tr><th scope="col">Не выполнено</th><th scope="col">Причина</th></tr></thead>
              <tbody>{i.notDone.map(([what, why]) => <tr><td>{what}</td><td>{why}</td></tr>)}</tbody>
            </table>
          </div>
        </article>; })}

        <div class="doc-note"><p><b>Общие границы.</b></p><ul>{general.map((g) => <li>{g}</li>)}</ul></div>
      </section>

      <footer class="doc-footer"><span>Подготовка производства · Входящие данные</span><span>Редакция от {edition}</span><a href="#top">Наверх ↑</a></footer>
    </main>
  </div>

  <dialog id="image-dialog" class="image-viewer" aria-labelledby="image-dialog-title"><div class="viewer-top"><div class="viewer-heading"><h2 id="image-dialog-title"></h2><p id="image-dialog-note" class="caption"></p></div><div class="viewer-tools" role="toolbar" aria-label="Масштаб изображения"><button type="button" class="diagram-button" id="image-zoom-out" aria-label="Уменьшить">−</button><output id="image-zoom-label" aria-live="polite">100%</output><button type="button" class="diagram-button" id="image-zoom-in" aria-label="Увеличить">+</button><button type="button" class="diagram-button" id="image-fit">Вписать</button><button type="button" class="diagram-button" id="image-actual">1:1</button><button type="button" class="close-button" id="close-image" aria-label="Закрыть скриншот"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div></div><div class="viewer-stage" id="image-stage"><img id="image-dialog-img" alt="" draggable="false"/></div><p class="caption viewer-hint">Колёсико мыши — масштаб к курсору · левая кнопка — перемещение · двойной щелчок — вписать / 100% · щелчок по пустому месту или Esc — закрыть.</p></dialog>
  <script src="../scripts/plan.ts"></script>
</body>
</html>
