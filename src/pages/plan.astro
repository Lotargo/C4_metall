---
import planScreens from '../data/plan-screens.json';
import { kinds, overallRoute, references, items, general } from '../data/plan.mjs';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '../styles/global.css';
import '../styles/plan.css';
const shots = Object.fromEntries(planScreens.map((s) => [s.id, s]));
const stateCount = (s) => items.filter((i) => i.state === s).length;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Общий план — входящие данные</title>
  <meta name="description" content="Как в «Подготовке производства» реализована работа с входящими данными: требования, поверхности, материал, заготовка, масса и база станков. Что сделано, как проверено и что ещё открыто." />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f7f6f2" />
  <meta property="og:title" content="Общий план — входящие данные" />
  <meta property="og:description" content="Шесть видов входящих данных: реализация, карта маршрута, скриншоты и открытые вопросы." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="plan-page">
  <a class="skip-link" href="#main">Перейти к содержанию</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">ПП</span><span>Подготовка<br/>производства</span></a>
      <nav aria-label="Разделы плана"><a href="#overview">Обзор</a><a href="#items">Входящие данные</a><a href="#bounds">Границы</a></nav>
      <a class="audience-link" href="/">К презентации <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main">
    <section class="hero" id="top">
      <div class="wrap">
        <p class="eyebrow">Общий план · состояние на 21 октября 2026</p>
        <h1>Общий план.<br/><span>Входящие данные.</span></h1>
        <p class="lead">Шесть видов данных, из которых складываются маршрут и смета детали. По каждому — как это работает, по какому маршруту идут данные, как выглядит на экране и что ещё не сделано.</p>
        <div class="plan-status" id="overview">
          {items.map((i) => <a class="plan-status-card" href={'#' + i.id} data-goto={i.id}>
            <span class="plan-num">{i.number}</span>
            <span class="plan-status-title">{i.title}</span>
            <span class:list={['badge', 'state-' + i.state]}>{i.stateLabel}</span>
          </a>)}
        </div>
        <p class="chapter-footnote">«Работает» — функция есть в интерфейсе и проверена на рабочих или тестовых примерах. Оговорка после «работает» (жёлтая метка) значит, что основная часть действует, а отдельные данные неизвестны или зависят от решения технолога. Без оговорок: {stateCount('done')} из {items.length}; с оговорками: {stateCount('partial')}.</p>
      </div>
    </section>

    <section class="section wash" id="route"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">Общая карта маршрута</p><h2>От чертежа<br/>до сметы.</h2></div><p class="section-intro">Все шесть видов данных проходят один путь: модель читает, программа хранит и считает, технолог проверяет и решает. Справочники подключаются там, где нужны числа.</p></div>
      <ol class="route-map route-overall" aria-label="Общий маршрут данных">{overallRoute.map((n) => <li class={'node kind-' + n.kind}><span class="node-kind">{kinds[n.kind]}</span><b>{n.title}</b><span class="node-text">{n.text}</span></li>)}</ol>
      <div class="route-refs"><span class="muted">Справочники:</span>{references.map((r) => <span class="ref-chip">{r}</span>)}</div>
      <div class="route-legend" aria-label="Обозначения">{Object.entries(kinds).map(([k, v]) => <span class={'legend kind-' + k}><i aria-hidden="true"></i>{v}</span>)}</div>
    </div></section>

    <section class="section" id="items"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">Входящие данные 0.1–0.6</p><h2>Шесть вкладок —<br/>шесть задач.</h2></div><p class="section-intro">Скриншоты сделаны в настоящем интерфейсе во время проверок 19–21 октября. Нажмите на снимок, чтобы открыть его в исходном размере.</p></div>
      <div class="plan-tabs tabs" role="tablist" aria-label="Входящие данные">{items.map((i, n) => <button role="tab" id={'tab-' + i.id} data-tab={i.id} aria-controls={'panel-' + i.id} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1}><span class="tab-num">{i.number}</span> {i.short}</button>)}</div>
      {items.map((i, n) => <article class="plan-panel" id={'panel-' + i.id} role="tabpanel" aria-labelledby={'tab-' + i.id} hidden={n !== 0}>
        <div class="panel-head">
          <div><p class="eyebrow">Пункт {i.number}</p><h3>{i.title}</h3></div>
          <span class:list={['badge', 'state-' + i.state]}>{i.stateLabel}</span>
        </div>
        <p class="panel-summary">{i.summary}</p>

        <h4 class="block-title">Как это реализовано</h4>
        <ol class="how-list">{i.how.map(([k, t]) => <li><span class={'who kind-' + k}>{kinds[k]}</span><span>{t}</span></li>)}</ol>

        <h4 class="block-title">Карта маршрута</h4>
        <ol class="route-map" aria-label={'Маршрут данных: ' + i.title}>{i.route.map((r) => <li class:list={['node', 'kind-' + r.kind, { here: r.here }]}><span class="node-kind">{kinds[r.kind]}{r.here && ' · этот пункт'}</span><b>{r.title}</b><span class="node-text">{r.text}</span></li>)}</ol>

        <h4 class="block-title">Что получилось</h4>
        <ul class="fact-list result-list">{i.results.map((r) => <li>{r}</li>)}</ul>

        <h4 class="block-title">Как это выглядит</h4>
        <div class="shot-grid">{i.shots.map((id) => { const s = shots[id]; return <figure class="plan-shot"><button class="screenshot-button" data-image={s.id} aria-label={'Увеличить скриншот: ' + s.title}><img src={s.file} width={s.width} height={s.height} alt={s.title} loading="lazy" /></button><figcaption><b>{s.title}.</b> {s.note} <span class="shot-date">Снимок от {s.date}.</span></figcaption></figure>; })}</div>

        <div class="not-done">
          <h4>Что не выполнено и почему</h4>
          <ul>{i.notDone.map(([what, why]) => <li><b>{what}</b><span>{why}</span></li>)}</ul>
        </div>
      </article>)}
    </div></section>

    <section class="section wash" id="bounds"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">Общие границы</p><h2>Что важно<br/>держать в уме.</h2></div><p class="section-intro">Состояние описано по итогам проверок 19–21 октября 2026 года.</p></div>
      <div class="limits">{general.map((g, n) => <article><span class="ordinal">0{n + 1}</span><p>{g}</p></article>)}</div>
      <div class="conclusion-links plan-links"><a class="secondary-button" href="/">Презентация продукта ↗</a><a class="secondary-button" href="/it/" target="_blank" rel="noopener">Технический разбор для IT ↗</a></div>
    </div></section>
  </main>
  <footer><div class="wrap footer-inner"><span>Подготовка производства / Общий план</span><span>Состояние на 21 октября 2026</span><a href="#top">Наверх ↑</a></div></footer>
  <dialog id="image-dialog" aria-labelledby="image-dialog-title"><div class="dialog-top"><h2 id="image-dialog-title"></h2><button class="icon-button" id="close-image" aria-label="Закрыть скриншот">×</button></div><p id="image-dialog-note" class="caption"></p><div class="image-scroll"><img id="image-dialog-img" alt=""/></div><p class="caption">Сохранённый снимок интерфейса в исходном разрешении; при необходимости используйте прокрутку.</p></dialog>
  <noscript><p class="wrap">Для переключения вкладок включите JavaScript.</p></noscript>
  <script src="../scripts/plan.ts"></script>
</body>
</html>
